<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget: 4 by 2 cells to start, with room for the meter and 2 or 3 favourites.
    Glance draws it, so the first layout is Glance's own while it loads. It needs no timed updates:
    the app redraws it when a dose is logged and at each day start.
-->
<!-- The target cells are for Android 12 and newer; older launchers go by the minimum size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
