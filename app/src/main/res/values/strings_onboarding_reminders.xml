<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 6 follow-up: the reminders step in onboarding (onboarding-6b-reminders), between the day start and done. -->
<resources>

    <!-- The day start's button, naming the step after it -->
    <string name="onboarding_next_reminders">Next: your reminders</string>

    <!-- The reminders step. The switches' titles and details are the Reminders page's own. -->
    <string name="onboarding_reminders_title">Which reminders do you want?</string>
    <string name="onboarding_reminders_body">To start with, 4 are on. None of them will ever say it\'s time for a dose.</string>
    <string name="onboarding_reminders_hint_quiet">Nothing shows from %1$s to %2$s. You can change all of this later in Settings, under Reminders.</string>
    <string name="onboarding_reminders_hint">You can change all of this later in Settings, under Reminders.</string>
    <string name="onboarding_reminders_allow">Allow notifications and finish</string>
    <string name="onboarding_reminders_allow_note">Your phone asks next. Set-up finishes either way.</string>

    <!-- The done step's summary row, beside the Settings row's own summary -->
    <string name="onboarding_summary_reminders">Reminders</string>
    <!-- Set-up offers only some reminders, so its summary counts what's on rather than "4 of 5 on" -->
    <plurals name="onboarding_summary_reminders_on">
        <item quantity="one">%1$d reminder on</item>
        <item quantity="other">%1$d reminders on</item>
    </plurals>
    <plurals name="onboarding_summary_reminders_on_quiet">
        <item quantity="one">%1$d reminder on, quiet from %2$s to %3$s</item>
        <item quantity="other">%1$d reminders on, quiet from %2$s to %3$s</item>
    </plurals>
</resources>
