    <string name="onboarding_app_sub">Quit NRT</string>
    <string name="onboarding_welcome_body">Log your NRT, see what sets off cravings, and taper to zero a week at a time.</string>
    <string name="onboarding_before_title">Before you start</string>
    <string name="onboarding_point_advice_lead">This app isn\'t medical advice.</string>
    <string name="onboarding_point_advice">It helps you keep track and plan. It can\'t tell you what\'s right for your body.</string>
    <string name="onboarding_point_pharmacist_lead">Talk to a pharmacist or GP</string>
    <string name="onboarding_point_pharmacist">before you change how you use NRT, especially if you\'re pregnant, breastfeeding or living with a heart condition.</string>
    <string name="onboarding_point_safer_lead">NRT for longer is far safer than smoking.</string>
    <string name="onboarding_point_safer">If cutting down gets hard, you can slow the plan down.</string>
    <string name="onboarding_privacy">Everything you log stays on this phone. The app has no internet access.</string>
    <string name="onboarding_accept">Accept and set up</string>
    <string name="onboarding_accept_note">You can read this again in Settings, under About.</string>

