<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission, on purpose: everything stays on the phone. -->

    <!-- The breathing and delay timers buzz. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The delay timer keeps the processor on until it ends, so it buzzes with the phone locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Reminders, asked for on Android 13 and newer the first time one is switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        WorkManager asks for this to watch the network for jobs that need it. The reminders don't,
        and the app never goes online, so it's left out.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".LastHitApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheLastHit">

        <!--
            singleTop, so a link from Tasker, an NFC sticker or a shortcut reaches the open app
            through onNewIntent. They start it as a new task, which finds the app's own task and its
            one screen on top. Not singleTask: that would close whatever sits above the screen when
            the app is opened again, such as the file picker for a backup, losing the export.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- lasthit://log?product=…&qty=…&at=…&tags=…, from Routines, Tasker or a shortcut. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lasthit" />
                <data android:host="log" />
            </intent-filter>
            <!-- The same link written to an NFC sticker. Reading it needs no NFC permission. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="lasthit" />
                <data android:host="log" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The delay timer's end, booked as it starts, so it's told of after the app is closed. -->
        <receiver
            android:name=".reminders.DelayEndReceiver"
            android:exported="false" />

        <!-- The home-screen widget: today against the guide, and favourites that log at a tap. -->
        <receiver
            android:name=".widget.LastHitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- The widget's tag picker: a sheet over the home screen, in a task of its own. -->
        <activity
            android:name=".widget.QuickTagsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.TheLastHit.Sheet" />

        <!-- The Quick Settings tile, which logs the first product on the quick log. -->
        <service
            android:name=".tile.LogTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_log"
            android:label="@string/shortcut_log"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- "All good" and Undo on a notification. -->
        <receiver
            android:name=".reminders.NoticeActionReceiver"
            android:exported="false" />

        <!--
            The AppFunctions for Gemini and other on-device agents (app/agents, docs/APPFUNCTIONS.md).
            The AppFunctions compiler writes the service and the function list. Only the system binds
            it, and the library's flag switches it on from Android 16, where AppFunctions start.
        -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_metadata" />
        <service
            android:name=".agents.NrtAppFunctionService"
            android:enabled="@bool/enablePlatformAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="nrt_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
